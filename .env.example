# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
# Needed when config.toml sets [jellyfin] url: Jellyfin Dashboard, API Keys.
# JELLYFIN_KEY=
# Optional relay: copy these three lines from the relay's first-start log.
# RELAY_URL=https://relay-address:8443
# RELAY_KEY=
# RELAY_FINGERPRINT=
# More relays: the same three names ending _2, _3 and so on.
# RELAY_URL_2=https://second-relay:8443
# RELAY_KEY_2=
# RELAY_FINGERPRINT_2=
# setup.sh sets the helper's transient socket directory, including when the helper is disabled.
HELPER_SOCKET_DIR=/tmp/shazzzbot-helper/socket
# Match socket_gid in the root-owned helper config; peer_uids must include the bot uid, 10001.
HELPER_GID=10001
# Set this to the helper's api.key when enabling [helper] in config.toml.
# SHAZZZBOT_HELPER_KEY=
